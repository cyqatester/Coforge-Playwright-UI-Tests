{
  "name": "coforge-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI tests for Coforge with Page Object Model and GitHub Actions environments",
  "scripts": {
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3"
  }
}
